---
// Starlight's header with the site's own sections added.
//
// On a wide screen the sections sit beside the search box. On a phone they
// stay in the header only on pages with no sidebar - the home, Why and
// Examples pages - because a page with a sidebar has a menu button there
// instead, and the menu lists them (MobileMenuFooter.astro). Narrow splash
// pages keep search and the theme selector beside the title, with the site
// sections in a second row. They have no sidebar menu to hold preferences.
import Search from '@astrojs/starlight/components/Search.astro';
import SiteTitle from '@astrojs/starlight/components/SiteTitle.astro';
import SocialIcons from '@astrojs/starlight/components/SocialIcons.astro';
import ThemeSelect from '@astrojs/starlight/components/ThemeSelect.astro';
import SiteNavigation from '../SiteNavigation.astro';
---

<div class="header">
	<div class="title-wrapper sl-flex">
		<SiteTitle />
	</div>
	<div class="sl-flex print:hidden search">
		<Search />
	</div>
	<div class="sl-flex print:hidden right-group">
		<SiteNavigation class="header-nav" />
		<div class="sl-hidden md:sl-flex social-icons">
			<SocialIcons />
		</div>
		<div class="sl-flex theme-select">
			<ThemeSelect />
		</div>
	</div>
</div>

<style>
	.header {
		display: flex;
		gap: var(--sl-nav-gap);
		justify-content: space-between;
		align-items: center;
		height: 100%;
	}

	.title-wrapper {
		overflow: clip;
		padding: 0.25rem;
		margin: -0.25rem;
		min-width: 0;
	}

	.right-group,
	.social-icons {
		gap: 1rem;
		align-items: center;
	}
	.social-icons::before {
		content: '';
		height: 2rem;
		border-inline-start: 1px solid var(--sl-color-gray-5);
	}
	.social-icons::after {
		content: '';
		height: 2rem;
		border-inline-end: 1px solid var(--sl-color-gray-5);
	}

	@media (max-width: 49.99rem) {
		:global(:root[data-has-sidebar]) .right-group {
			display: none;
		}
		.right-group :global(.site-nav ul) {
			gap: 0.875rem;
		}
		:global(:root:not([data-has-sidebar])) {
			--sl-nav-height: 6rem;
		}
		:global(:root:not([data-has-sidebar])) .header {
			display: grid;
			grid-template-columns: minmax(0, 1fr) auto auto;
			grid-template-rows: 1fr 1fr;
			row-gap: 0;
		}
		:global(:root:not([data-has-sidebar])) .search {
			grid-column: 2;
			grid-row: 1;
		}
		:global(:root:not([data-has-sidebar])) .right-group {
			display: contents;
		}
		:global(:root:not([data-has-sidebar])) .theme-select {
			grid-column: 3;
			grid-row: 1;
		}
		:global(:root:not([data-has-sidebar])) .header :global(.header-nav) {
			grid-column: 1 / -1;
			grid-row: 2;
		}
		:global(:root:not([data-has-sidebar])) .right-group :global(.site-nav ul) {
			justify-content: space-between;
		}
	}

	@media (min-width: 50rem) {
		:global(:root[data-has-sidebar]) {
			--__sidebar-pad: calc(2 * var(--sl-nav-pad-x));
		}
		:global(:root:not([data-has-toc])) {
			--__toc-width: 0rem;
		}
		.header {
			--__sidebar-width: max(0rem, var(--sl-content-inline-start, 0rem) - var(--sl-nav-pad-x));
			--__main-column-fr: calc(
				(
						100% + var(--__sidebar-pad, 0rem) - var(--__toc-width, var(--sl-sidebar-width)) -
							(2 * var(--__toc-width, var(--sl-nav-pad-x))) - var(--sl-content-inline-start, 0rem) -
							var(--sl-content-width)
					) / 2
			);
			display: grid;
			grid-template-columns:
				minmax(
					calc(var(--__sidebar-width) + max(0rem, var(--__main-column-fr) - var(--sl-nav-gap))),
					auto
				)
				1fr
				auto;
			align-content: center;
		}
	}
</style>
