---
// Reuse the exact reviewed sample frame through the existing asset pipeline.
// The imported URL retains Astro's release base and content hash.
import Default from '@astrojs/starlight/components/Head.astro';
import frame from '../../assets/captures/linesweeper-play.png';

if (!Astro.site) throw new Error('Link-preview images require the configured site origin.');
const image = new URL(frame.src, Astro.site).href;
const alt = 'LineSweeper: a scripted October 2026 frame with a yellow square above a multicoloured block stack, beside hold and next-piece slots and a score of 4694.';
---

<Default />
<meta property="og:image" content={image} />
<meta property="og:image:type" content="image/png" />
<meta property="og:image:width" content={String(frame.width)} />
<meta property="og:image:height" content={String(frame.height)} />
<meta property="og:image:alt" content={alt} />
<meta name="twitter:image" content={image} />
<meta name="twitter:image:alt" content={alt} />
