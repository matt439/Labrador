---
// The vcpkg.json a project consuming Labrador needs, derived from Labrador's
// own so that the two cannot drift apart.
//
// vcpkg reads the manifest of the top-level project only, so a game has to
// name the engine's dependencies itself, and should pin them to the same
// baseline the engine is built and tested against. Every package is carried:
// the engine decodes PNG textures with lodepng, and the game's own tests use
// doctest.
// tools/consumer_check/assemble.py derives the same manifest for the project
// CI builds, so a change to this rule is made there too.
import { Code } from '@astrojs/starlight/components';
import { readRepositoryFile } from '../lib/repository';

interface Props {
	name: string;
}

const engine = JSON.parse(readRepositoryFile('vcpkg.json'));
const dependencies = engine.dependencies as (string | { name: string })[];

const manifest = {
	name: Astro.props.name,
	'version-string': '0.1.0',
	dependencies,
	'builtin-baseline': engine['builtin-baseline'],
};
---

<Code code={JSON.stringify(manifest, null, 2)} lang="json" title="vcpkg.json" />
