include_guard(GLOBAL)

# Supplement discovery failures with the consumer's manifest obligation. This
# inspects direct declarations and explicitly selected/default features only;
# it does not resolve vcpkg's dependency graph or compare baselines.
function(labrador_dependency_advice result package port)
    cmake_parse_arguments(PARSE_ARGV 3 DEPENDENCY "HOST" "FEATURE" "")
    set(consumer_manifest "${CMAKE_SOURCE_DIR}/vcpkg.json")
    get_filename_component(engine_manifest "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../vcpkg.json" ABSOLUTE)
    set(declared OFF)
    if(EXISTS "${consumer_manifest}")
        file(READ "${consumer_manifest}" manifest)
        string(JSON dependencies ERROR_VARIABLE dependencies_error GET "${manifest}" dependencies)
        if(NOT dependencies_error)
            set(groups "${dependencies}")
            set(selected_features ${VCPKG_MANIFEST_FEATURES})
            if(NOT VCPKG_MANIFEST_NO_DEFAULT_FEATURES)
                string(JSON defaults ERROR_VARIABLE defaults_error GET "${manifest}" default-features)
                if(NOT defaults_error)
                    string(JSON defaults_kind ERROR_VARIABLE defaults_kind_error TYPE "${defaults}")
                    string(JSON default_count ERROR_VARIABLE default_count_error LENGTH "${defaults}")
                    if(NOT defaults_kind_error AND defaults_kind STREQUAL "ARRAY" AND
                            NOT default_count_error AND default_count GREATER 0)
                        math(EXPR default_last "${default_count} - 1")
                        foreach(index RANGE 0 ${default_last})
                            string(JSON feature GET "${defaults}" ${index})
                            list(APPEND selected_features "${feature}")
                        endforeach()
                    endif()
                endif()
            endif()
            foreach(feature IN LISTS selected_features)
                string(JSON feature_dependencies ERROR_VARIABLE feature_error
                    GET "${manifest}" features "${feature}" dependencies)
                if(NOT feature_error)
                    list(APPEND groups "${feature_dependencies}")
                endif()
            endforeach()
            foreach(group IN LISTS groups)
                string(JSON group_kind ERROR_VARIABLE group_error TYPE "${group}")
                if(group_error OR NOT group_kind STREQUAL "ARRAY")
                    continue()
                endif()
                string(JSON dependency_count ERROR_VARIABLE count_error LENGTH "${group}")
                if(NOT count_error AND dependency_count GREATER 0)
                    math(EXPR dependency_last "${dependency_count} - 1")
                    foreach(index RANGE 0 ${dependency_last})
                        string(JSON kind TYPE "${group}" ${index})
                        if(kind STREQUAL "STRING")
                            string(JSON name GET "${group}" ${index})
                        else()
                            string(JSON name ERROR_VARIABLE name_error GET "${group}" ${index} name)
                        endif()
                        if(name STREQUAL port)
                            set(declared ON)
                        endif()
                    endforeach()
                endif()
            endforeach()
        endif()
    endif()

    set(declaration "\"${port}\"")
    if(DEPENDENCY_FEATURE OR DEPENDENCY_HOST)
        set(declaration "{ \"name\": \"${port}\"")
        if(DEPENDENCY_FEATURE)
            string(APPEND declaration ", \"features\": [\"${DEPENDENCY_FEATURE}\"]")
        endif()
        if(DEPENDENCY_HOST)
            string(APPEND declaration ", \"host\": true")
        endif()
        string(APPEND declaration " }")
    endif()
    set(advice "Labrador could not discover ${package}. ")
    if(declared)
        string(APPEND advice "The consumer manifest ${consumer_manifest} already declares ${port}. Check CMAKE_TOOLCHAIN_FILE, selected triplets and installed package discovery; do not add a duplicate dependency or replace a working baseline. ")
        if(DEPENDENCY_FEATURE)
            string(APPEND advice "Ensure that declaration enables the ${DEPENDENCY_FEATURE} feature for ${port}. ")
        endif()
        if(DEPENDENCY_HOST)
            string(APPEND advice "This executable needs a host dependency (\"host\": true). ")
        endif()
    else()
        string(APPEND advice "If using vcpkg, add ${declaration} to the dependencies in the consumer's ${consumer_manifest}, or enable its existing feature that supplies it. An engine subdirectory does not install its own manifest. ")
    endif()
    string(APPEND advice "Compare the selected dependency with ${engine_manifest}. Other package installations remain supported.")
    set(${result} "${advice}" PARENT_SCOPE)
endfunction()

# Only imported targets are consumed from these config packages; package-local
# variables are not part of this helper's result. Preserve CMake's recorded
# reason, considered configurations/versions and directory hint on failure.
# Do not retry a failed config: it may have left partial imported targets whose
# guards would make a second lookup incorrectly succeed.
function(labrador_find_package package)
    cmake_parse_arguments(PARSE_ARGV 1 DEPENDENCY "" "PORT;FEATURE" "")
    if(NOT DEPENDENCY_PORT)
        set(DEPENDENCY_PORT "${package}")
    endif()
    set(${package}_FOUND FALSE)
    unset(${package}_NOT_FOUND_MESSAGE)
    unset(${package}_CONSIDERED_CONFIGS)
    unset(${package}_CONSIDERED_VERSIONS)
    find_package(${package} CONFIG QUIET)
    if(NOT ${package}_FOUND)
        set(feature_argument "")
        if(DEPENDENCY_FEATURE)
            set(feature_argument FEATURE "${DEPENDENCY_FEATURE}")
        endif()
        labrador_dependency_advice(advice "CMake package '${package}'" "${DEPENDENCY_PORT}" ${feature_argument})
        set(details "")
        if(CMAKE_DISABLE_FIND_PACKAGE_${package})
            string(APPEND details "\nCMAKE_DISABLE_FIND_PACKAGE_${package} is enabled; a required Labrador package cannot be disabled.")
        endif()
        if(DEFINED ${package}_NOT_FOUND_MESSAGE AND NOT "${${package}_NOT_FOUND_MESSAGE}" STREQUAL "")
            string(APPEND details "\nCMake's package failure reason: ${${package}_NOT_FOUND_MESSAGE}")
        endif()
        if(${package}_CONSIDERED_CONFIGS)
            string(REPLACE ";" "\n  " considered "${${package}_CONSIDERED_CONFIGS}")
            string(APPEND details "\nCMake's considered configurations:\n  ${considered}")
            string(APPEND details "\nConsidered versions: ${${package}_CONSIDERED_VERSIONS}")
        elseif(NOT CMAKE_DISABLE_FIND_PACKAGE_${package})
            string(TOLOWER "${package}" lowercase_package)
            string(APPEND details "\nNo usable package configuration was found (${package}Config.cmake or ${lowercase_package}-config.cmake).")
        endif()
        string(APPEND details "\n${package}_DIR: ${${package}_DIR}\nCheck that directory or CMAKE_PREFIX_PATH against the intended installation.")
        message(FATAL_ERROR "${advice}\n${details}")
    endif()
endfunction()
