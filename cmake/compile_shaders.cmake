# Shader compilation, at build time.
#
# Compile HLSL before the game runs, so shader errors fail the build (T5) and
# the game needs no runtime HLSL compiler. Generated byte arrays stay in the
# build tree and depend on their source, avoiding checked-in bytecode that can
# drift from it. Backends include the generated C headers; no separate shader
# file needs deployment beside the executable.

# compile_hlsl(<target> <source> <profile> <entry> <symbol> <output>)
#
# `symbol` is the name of the byte array in the generated header, and `output`
# is that header's path relative to the generated include root - so a backend
# includes it the way it includes anything else, from the repository root
# (CONVENTIONS).
function(compile_hlsl target source profile entry symbol output)
    # Find the Windows SDK's fxc only when a backend requests Direct3D HLSL.
    # Including this module imposes no compiler requirement on other backends.
    # A missing fxc stops configure with a message naming the prompt that
    # supplies it, because the usual cause is the wrong shell, not a missing
    # install (T6).
    find_program(FXC_EXECUTABLE
        NAMES fxc
        DOC "The Direct3D shader compiler, from the Windows SDK"
    )
    if(NOT FXC_EXECUTABLE)
        message(FATAL_ERROR
            "No Direct3D shader compiler (fxc). The Direct3D 11 and Direct3D "
            "12 renderers, which the x64-debug, x64-release and *-d3d12 "
            "presets build, compile ${source} with fxc.exe from the Windows "
            "SDK, and it is looked for on PATH. Configure from the x64 Native "
            "Tools Command Prompt, which puts the Windows SDK's tools on PATH; "
            "an ordinary Command Prompt or PowerShell window does not. If "
            "'where fxc' finds nothing in that prompt either, add the Windows "
            "SDK in the Visual Studio Installer under Desktop development with "
            "C++. Then configure again.")
    endif()

    set(generated_root "${CMAKE_BINARY_DIR}/generated")
    set(generated_file "${generated_root}/${output}")

    get_filename_component(generated_directory "${generated_file}" DIRECTORY)
    file(MAKE_DIRECTORY "${generated_directory}")

    add_custom_command(
        OUTPUT "${generated_file}"
        COMMAND "${FXC_EXECUTABLE}"
            /nologo
            /T ${profile}
            /E ${entry}
            /Fh "${generated_file}"
            /Vn ${symbol}
            "${source}"
        DEPENDS "${source}"
        COMMENT "Compiling ${entry} (${profile}) from ${source}"
        VERBATIM
    )

    target_sources(${target} PRIVATE "${generated_file}")
    target_include_directories(${target} PRIVATE "${generated_root}")
endfunction()

# compile_hlsl_to_spirv(<target> <source> <profile> <entry> <symbol> <output>)
#
# dxc emits SPIR-V from the same engine/render/sprite.hlsl used by Direct3D;
# no Vulkan-specific copy of the source is needed. engine/CMakeLists.txt owns
# the selected profile, while this function owns the descriptor binding shifts.
#
# Require the Vulkan SDK's dxc from VULKAN_SDK/Bin with NO_DEFAULT_PATH. A
# Windows SDK dxc found through PATH can lack SPIR-V code generation despite
# advertising the flags; the error names the required SDK (T6).
#
# HLSL has separate b, t and s register namespaces; Vulkan descriptor-set
# bindings share one namespace. The shifts map b0, t0 and s0 to set 0 bindings
# 0, 1 and 2, matching the transform, texture and sampler layout in
# engine/render/vulkan/renderer.cpp. Binding policy stays out of the shader.
function(compile_hlsl_to_spirv target source profile entry symbol output)
    # Find the SPIR-V compiler only when requested, so other backends do not
    # require a Vulkan SDK merely to include this module.
    find_program(DXC_SPIRV_EXECUTABLE
        NAMES dxc
        HINTS "$ENV{VULKAN_SDK}/Bin"
        NO_DEFAULT_PATH
        DOC "The DirectX shader compiler from the Vulkan SDK, which emits SPIR-V"
    )
    if(NOT DXC_SPIRV_EXECUTABLE)
        message(FATAL_ERROR
            "No SPIR-V compiler. This backend compiles engine/render/sprite.hlsl "
            "to SPIR-V with the Vulkan SDK's dxc, which is looked for in "
            "$ENV{VULKAN_SDK}/Bin and deliberately not on PATH - the Windows "
            "SDK ships a dxc.exe of the same name that PATH finds first and "
            "that has no SPIR-V backend compiled in. Install the Vulkan SDK "
            "(https://vulkan.lunarg.com/) so that VULKAN_SDK is set.")
    endif()

    set(generated_root "${CMAKE_BINARY_DIR}/generated")
    set(generated_file "${generated_root}/${output}")

    get_filename_component(generated_directory "${generated_file}" DIRECTORY)
    file(MAKE_DIRECTORY "${generated_directory}")

    add_custom_command(
        OUTPUT "${generated_file}"
        COMMAND "${DXC_SPIRV_EXECUTABLE}"
            -nologo
            -spirv
            -T ${profile}
            -E ${entry}
            -fvk-b-shift 0 0
            -fvk-t-shift 1 0
            -fvk-s-shift 2 0
            -Fh "${generated_file}"
            -Vn ${symbol}
            "${source}"
        DEPENDS "${source}"
        COMMENT "Compiling ${entry} (${profile}, SPIR-V) from ${source}"
        VERBATIM
    )

    target_sources(${target} PRIVATE "${generated_file}")
    target_include_directories(${target} PRIVATE "${generated_root}")
endfunction()
