# Turns the selected backend's compiled pixel shader into a MaterialSource.
# Invoked by labrador_add_material, never by a game directly.
foreach(argument NAME KIND OUTPUT)
    if(NOT DEFINED ${argument} OR "${${argument}}" STREQUAL "")
        message(FATAL_ERROR "embed_material needs ${argument}")
    endif()
endforeach()
if(NOT NAME MATCHES "^[a-z][a-z0-9_]*$")
    message(FATAL_ERROR "Invalid material name: ${NAME}")
endif()
if(NOT KIND MATCHES "^(d3d11|d3d12|spirv|glsl|null)$")
    message(FATAL_ERROR "Unknown material byte kind: ${KIND}")
endif()

set(payload "")
if(NOT KIND STREQUAL "null")
    if(NOT DEFINED INPUT OR NOT EXISTS "${INPUT}")
        message(FATAL_ERROR "No compiled shader for material ${NAME}: ${INPUT}")
    endif()
    if(KIND STREQUAL "glsl")
        file(READ "${INPUT}" shader)
        string(REPLACE "\r\n" "\n" shader "${shader}")
        string(REGEX REPLACE "^#version[^\n]*\n" "" shader "${shader}")
        string(REPLACE "precision mediump float;" "precision highp float;" shader "${shader}")
        string(REPLACE "type_PostFrame" "post_frame" shader "${shader}")
        string(REPLACE "SPIRV_Cross_Combinedinput_0point_sampler" "input_0_point" shader "${shader}")
        string(REPLACE "SPIRV_Cross_Combinedinput_0linear_sampler" "input_0_linear" shader "${shader}")
        if(shader MATCHES "SPIRV_Cross_Combined[a-zA-Z0-9_]+")
            message(FATAL_ERROR "Material ${NAME} uses a texture or sampler outside the post frame: ${CMAKE_MATCH_0}")
        endif()
        if(shader MATCHES "mediump|#version")
            message(FATAL_ERROR "Material ${NAME} has an unsupported GLSL precision or version declaration")
        endif()
        # The fixed frame is the complete resource contract. Refuse extra
        # uniforms instead of letting an unbound resource silently draw zero.
        string(REGEX MATCHALL "uniform[^;]+" uniforms "${shader}")
        foreach(uniform IN LISTS uniforms)
            if(NOT uniform MATCHES "^uniform (highp )?vec4 post_frame\\[([1-9]|10|11)\\]$"
                AND NOT uniform MATCHES "^uniform (highp )?sampler2D input_0_(point|linear)$")
                message(FATAL_ERROR "Material ${NAME} declares a resource outside the post frame: ${uniform}")
            endif()
        endforeach()
        # The leading newline separates the context's version prelude. The
        # terminator is part of the span: GL consumes it as a C string.
        string(HEX "\n${shader}" payload)
        string(APPEND payload "00")
    else()
        file(READ "${INPUT}" payload HEX)
    endif()
    if(payload STREQUAL "")
        message(FATAL_ERROR "Empty compiled shader for material ${NAME}")
    endif()
endif()

set(header "#pragma once\n\n#include \"engine/render/material.h\"\n\nnamespace labrador\n{\n")
if(KIND STREQUAL "null")
    string(APPEND header "\tinline constexpr MaterialSource ${NAME}{MaterialKind::null, {}, \"${NAME}\"};\n")
else()
    string(REGEX REPLACE "([0-9a-fA-F][0-9a-fA-F])" "0x\\1," bytes "${payload}")
    string(APPEND header "\tinline constexpr unsigned char ${NAME}_bytes[] = {${bytes}};\n")
    string(APPEND header "\tinline constexpr MaterialSource ${NAME}{MaterialKind::${KIND}, ${NAME}_bytes, \"${NAME}\"};\n")
endif()
string(APPEND header "}\n")
get_filename_component(output_directory "${OUTPUT}" DIRECTORY)
file(MAKE_DIRECTORY "${output_directory}")
file(WRITE "${OUTPUT}" "${header}")
