{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 26, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "inherits": "common",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "architecture": { "value": "x64", "strategy": "external" }
    },
    {
      "name": "x64-debug",
      "displayName": "x64 Debug",
      "inherits": "base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    },
    {
      "name": "x64-release",
      "displayName": "x64 Release",
      "inherits": "base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    },
    {
      "name": "x64-debug-d3d12",
      "displayName": "x64 Debug (Direct3D 12)",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "LABRADOR_RENDER_BACKEND": "d3d12"
      }
    },
    {
      "name": "x64-release-d3d12",
      "displayName": "x64 Release (Direct3D 12)",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "LABRADOR_RENDER_BACKEND": "d3d12"
      }
    },
    {
      "name": "x64-debug-gl",
      "displayName": "x64 Debug (OpenGL)",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "LABRADOR_RENDER_BACKEND": "gl"
      }
    },
    {
      "name": "x64-release-gl",
      "displayName": "x64 Release (OpenGL)",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "LABRADOR_RENDER_BACKEND": "gl"
      }
    },
    {
      "name": "x64-debug-vulkan",
      "displayName": "x64 Debug (Vulkan)",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "LABRADOR_RENDER_BACKEND": "vulkan"
      }
    },
    {
      "name": "x64-release-vulkan",
      "displayName": "x64 Release (Vulkan)",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "LABRADOR_RENDER_BACKEND": "vulkan"
      }
    },
    {
      "name": "x64-debug-null",
      "displayName": "x64 Debug (null render and audio)",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "LABRADOR_RENDER_BACKEND": "null",
        "LABRADOR_AUDIO_BACKEND": "null"
      }
    },
    {
      "name": "x64-release-null",
      "displayName": "x64 Release (null render and audio)",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "LABRADOR_RENDER_BACKEND": "null",
        "LABRADOR_AUDIO_BACKEND": "null"
      }
    },
    {
      "name": "common",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "installDir": "${sourceDir}/out/install/${presetName}",
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake"
    },
    {
      "name": "wasm-base",
      "hidden": true,
      "inherits": "common",
      "cacheVariables": {
        "VCPKG_CHAINLOAD_TOOLCHAIN_FILE": "$env{EMSDK}/upstream/emscripten/cmake/Modules/Platform/Emscripten.cmake",
        "VCPKG_TARGET_TRIPLET": "wasm32-emscripten",
        "LABRADOR_RENDER_BACKEND": "gl",
        "LABRADOR_AUDIO_BACKEND": "webaudio",
        "LABRADOR_INPUT_BACKEND": "web"
      }
    },
    {
      "name": "wasm-debug",
      "displayName": "WebAssembly Debug (Emscripten)",
      "inherits": "wasm-base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    },
    {
      "name": "wasm-release",
      "displayName": "WebAssembly Release (Emscripten)",
      "inherits": "wasm-base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    }
  ],
  "buildPresets": [
    { "name": "x64-debug", "configurePreset": "x64-debug" },
    { "name": "x64-release", "configurePreset": "x64-release" },
    { "name": "x64-debug-d3d12", "configurePreset": "x64-debug-d3d12" },
    { "name": "x64-release-d3d12", "configurePreset": "x64-release-d3d12" },
    { "name": "x64-debug-gl", "configurePreset": "x64-debug-gl" },
    { "name": "x64-release-gl", "configurePreset": "x64-release-gl" },
    { "name": "x64-debug-vulkan", "configurePreset": "x64-debug-vulkan" },
    { "name": "x64-release-vulkan", "configurePreset": "x64-release-vulkan" },
    { "name": "x64-debug-null", "configurePreset": "x64-debug-null" },
    { "name": "x64-release-null", "configurePreset": "x64-release-null" },
    { "name": "wasm-debug", "configurePreset": "wasm-debug" },
    { "name": "wasm-release", "configurePreset": "wasm-release" }
  ],
  "testPresets": [
    { "name": "x64-debug", "configurePreset": "x64-debug", "inherits": "test-base" },
    { "name": "x64-release", "configurePreset": "x64-release", "inherits": "test-base" },
    { "name": "x64-debug-d3d12", "configurePreset": "x64-debug-d3d12", "inherits": "test-base" },
    { "name": "x64-release-d3d12", "configurePreset": "x64-release-d3d12", "inherits": "test-base" },
    { "name": "x64-debug-gl", "configurePreset": "x64-debug-gl", "inherits": "test-base" },
    { "name": "x64-release-gl", "configurePreset": "x64-release-gl", "inherits": "test-base" },
    { "name": "x64-debug-vulkan", "configurePreset": "x64-debug-vulkan", "inherits": "test-base" },
    { "name": "x64-release-vulkan", "configurePreset": "x64-release-vulkan", "inherits": "test-base" },
    { "name": "x64-debug-null", "configurePreset": "x64-debug-null", "inherits": "test-base" },
    { "name": "x64-release-null", "configurePreset": "x64-release-null", "inherits": "test-base" },
    { "name": "wasm-debug", "configurePreset": "wasm-debug", "inherits": "test-base" },
    { "name": "wasm-release", "configurePreset": "wasm-release", "inherits": "test-base" },
    {
      "name": "test-base",
      "hidden": true,
      "output": { "outputOnFailure": true }
    }
  ]
}
